alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL TRAP PowerShell-style Fileless Backdoor Beacon - Numeric Bot-ID URI Poll"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/"; startswith; pcre:"/^\/\d{6,12}(\?k=.*)?$/U"; threshold:type limit, track by_src, count 1, seconds 30; classtype:trojan-activity; sid:9000001; rev:1; metadata:created_at 2026_09_02, confidence high;)

